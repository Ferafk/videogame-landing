---
---

<section id="contacto" class="py-24 bg-game-overlay flex flex-col items-center">
  <div class="max-w-6xl mx-auto px-6 w-full">
    
    <!-- Logo Centrado 
    <div class="flex justify-center mb-16">
      <div class="bg-slate-100 p-6 md:p-8 rounded-3xl shadow-[0_0_40px_rgba(255,255,255,0.1)] transition-transform hover:scale-105 duration-300">
        <img src="/images/LogoOscar.png" alt="DevOs Logo" class="h-20 md:h-28 w-auto object-contain" loading="lazy" />
      </div>
    </div>-->

    <!-- Logo Centrado -->
    <div class="flex justify-center mb-16 px-4">
      <div class="w-full max-w-[200px] aspect-square bg-slate-100 rounded-full shadow-[0_0_40px_rgba(255,255,255,0.1)] flex items-center justify-center p-6 transition-transform hover:scale-105 duration-300">
        <img
          src="/images/LogoOscar.png"
          alt="DevOs Logo"
          class="w-full h-full object-contain"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Grid de Dos Columnas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-6 md:mb-8">
      
      <!-- Card 1: Juega y síguenos -->
      <div class="bg-game-card p-8 md:p-10 rounded-2xl border border-game-border shadow-2xl flex flex-col hover:border-game-accent/50 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-game-element flex items-center justify-center mb-6 border border-game-border-alt text-game-accent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <rect width="14" height="10" x="5" y="7" rx="2" stroke="currentColor"/>
            <circle cx="9" cy="12" r="1.5" fill="currentColor" stroke="none"/>
            <circle cx="15" cy="12" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-3">Juega y síguenos</h3>
        <p class="text-slate-400 text-base leading-relaxed mb-8 flex-grow">Descarga Logerint en itch.io y conoce más sobre nuestro estudio de desarrollo, DevOs.</p>
        <div class="flex flex-col xl:flex-row gap-3">
          <a href="#" class="flex items-center justify-center px-5 py-3.5 bg-game-cta hover:bg-game-cta-hover text-game-bg text-sm font-bold rounded-xl transition-colors gap-2 shadow-lg shadow-orange-900/20 whitespace-nowrap flex-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0018 0z" />
            </svg>
            Jugar en itch.io
          </a>
          <a href="#" class="flex items-center justify-center px-5 py-3.5 bg-game-element hover:bg-game-element-hover text-white text-sm font-medium rounded-xl border border-game-border-alt transition-colors gap-2 whitespace-nowrap flex-1">
            <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4l6 6m0 0l-6-6m6 6L3 4z" />
            </svg>
            Web del Estudio
          </a>
        </div>
      </div>

      <!-- Card 2: Únete a la comunidad -->
      <div class="bg-game-card p-8 md:p-10 rounded-2xl border border-game-border shadow-2xl flex flex-col hover:border-game-accent/50 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-game-element flex items-center justify-center mb-6 border border-game-border-alt text-game-accent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
            <circle cx="9" cy="7" r="4" stroke="currentColor"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-3">Únete a la comunidad</h3>
        <p class="text-slate-400 text-base leading-relaxed mb-8 flex-grow">Apoya el desarrollo continuo de Logerint y comparte con otros jugadores en nuestro servidor.</p>
        <div class="flex flex-col xl:flex-row gap-3">
          <a href="#" class="flex items-center justify-center px-5 py-3.5 bg-game-element hover:bg-game-element-hover text-white text-sm font-medium rounded-xl border border-game-border-alt transition-colors gap-2 group whitespace-nowrap flex-1">
            <svg class="w-5 h-5 text-[#f96854] group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <circle cx="12" cy="12" r="9"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 16V8h2.5a2.5 2.5 0 010 5H9" />
            </svg>
            Patreon
          </a>
          <a href="#" class="flex items-center justify-center px-5 py-3.5 bg-[#5865F2] hover:bg-[#4752C4] text-white text-sm font-medium rounded-xl transition-colors gap-2 shadow-lg shadow-indigo-900/20 whitespace-nowrap flex-1">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
            </svg>
            Discord
          </a>
        </div>
      </div>

    </div>

    <!-- Sigue nuestro trabajo -->
    <div class="bg-game-card p-8 md:p-10 rounded-2xl border border-game-border shadow-2xl flex flex-col lg:flex-row items-center gap-6 md:gap-8 hover:border-game-accent/50 transition-colors mb-6 md:mb-8">
      <div class="flex-shrink-0">
        <div class="w-16 h-16 rounded-2xl bg-game-element flex items-center justify-center border border-game-border-alt text-game-accent">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </div>
      </div>
      <div class="flex-grow text-center lg:text-left">
        <h3 class="text-2xl font-bold text-white mb-2">Sigue nuestro trabajo</h3>
        <p class="text-slate-400 text-base">Entérate de las últimas noticias, devlogs y contenido exclusivo de Logerint y futuros proyectos.</p>
      </div>
      <div class="flex flex-wrap justify-center lg:justify-end gap-3 w-full lg:w-auto mt-4 lg:mt-0">
        <a href="#" class="flex items-center justify-center p-3.5 bg-game-element hover:bg-game-element-hover text-white rounded-xl border border-game-border-alt transition-colors group" aria-label="Instagram">
          <svg class="w-6 h-6 text-slate-300 group-hover:text-pink-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <rect width="20" height="20" x="2" y="2" rx="5" stroke="currentColor"/>
            <circle cx="12" cy="12" r="3" stroke="currentColor"/>
            <path stroke-linecap="round" d="M20.67 6.67C19.62 5.62 18.18 5 16.5 5c-1.68 0-3.12.62-4.17 1.67M4.33 17.33c.97.97 1.97 1.67 3.17 1.67 1.68 0 3.12-.62 4.17-1.67M14.83 7.83c.97-.97 1.97-1.67 3.17-1.67 1.68 0 3.12.62 4.17 1.67M2.67 16.33c-.97-.97-1.97-1.67-3.17-1.67-1.68 0-3.12.62-4.17 1.67"/>
          </svg>
        </a>
        <a href="#" class="flex items-center justify-center p-3.5 bg-game-element hover:bg-game-element-hover text-white rounded-xl border border-game-border-alt transition-colors group" aria-label="Facebook">
          <svg class="w-6 h-6 text-slate-300 group-hover:text-blue-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
          </svg>
        </a>
        <a href="#" class="flex items-center justify-center p-3.5 bg-game-element hover:bg-game-element-hover text-white rounded-xl border border-game-border-alt transition-colors group" aria-label="YouTube">
          <svg class="w-6 h-6 text-slate-300 group-hover:text-red-500 transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M21.582 6.186a2.686 2.686 0 00-1.884-1.897C17.962 3.82 12 3.82 12 3.82s-5.962 0-7.698.469a2.686 2.686 0 00-1.884 1.897C1.948 7.942 1.948 12 1.948 12s0 4.058.47 5.814a2.686 2.686 0 001.884 1.897C6.038 20.18 12 20.18 12 20.18s5.962 0 7.698-.469a2.686 2.686 0 001.884-1.897C22.052 16.058 22.052 12 22.052 12s0-4.058-.47-5.814zM9.96 15.342V8.658L15.72 12l-5.76 3.342z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Ponte en contacto -->
    <div class="bg-game-card p-8 md:p-10 rounded-2xl border border-game-border shadow-2xl flex flex-col lg:flex-row items-center gap-6 md:gap-8 hover:border-game-accent/50 transition-colors">
      <div class="flex-shrink-0">
        <div class="w-16 h-16 rounded-2xl bg-game-element flex items-center justify-center border border-game-border-alt text-game-accent">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>
      </div>
      <div class="flex-grow text-center lg:text-left">
        <h3 class="text-2xl font-bold text-white mb-2">Ponte en contacto</h3>
        <p class="text-slate-400 text-base">¿Tienes alguna duda, sugerencia o propuesta? Escríbenos y te responderemos lo antes posible.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto mt-4 lg:mt-0">
        <a href="#" class="flex items-center justify-between lg:justify-center px-6 py-3.5 bg-game-element hover:bg-game-element-hover text-white text-sm font-medium rounded-xl border border-game-border-alt transition-colors gap-3 group whitespace-nowrap">
          Consultas generales
          <svg class="w-4 h-4 text-green-500 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="#" class="flex items-center justify-between lg:justify-center px-6 py-3.5 bg-game-element hover:bg-game-element-hover text-white text-sm font-medium rounded-xl border border-game-border-alt transition-colors gap-3 group whitespace-nowrap">
          Consultas comerciales al estudio
          <svg class="w-4 h-4 text-green-500 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Todos los links -->
    <div class="mt-12 flex justify-center">
      <a href="#" class="flex items-center justify-center px-5 py-2.5 bg-transparent hover:bg-game-element text-slate-400 hover:text-white text-xs font-semibold uppercase tracking-wider rounded-full border border-game-border hover:border-gray-600 transition-colors gap-2 group">
        <svg class="w-4 h-4 group-hover:-rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        Todos los links
      </a>
    </div>

  </div>
</section>
